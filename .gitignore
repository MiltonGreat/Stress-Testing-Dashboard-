# Power BI Desktop temp files
*.pbix~
*.pbix.tmp
*.pbit.tmp
~$*.pbix
~$*.pbit

# Backup files
*.backup
*.bak

# Power BI autosave
Autosave/

# Office temp files
~$*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Node_modules (if you add any tooling later)
node_modules/

# Python cache (if you add scripts)
__pycache__/
*.pyc

# Data — do NOT commit raw data
data/
*.csv
*.xlsx

# Note: include only if you have public sample data you're allowed to share
# Remove the *.csv rule if you want to commit a small sample
